#!/bin/bash
# Lists Apple provisioning-profile expiry dates for every app signed on this Mac,
# newest profile per app id. A device install stops launching when the profile it
# was installed with expires, so the newest matching profile approximates the
# deadline for the most recent install. Exits 1 if anything expires within 45 days.
#
#   apple-sign-expiry [--notify CMD [ARG...]]
#
# With --notify (meant for a daily launch agent), runs CMD ARG... with the message
# appended as the final argument whenever an app crosses a new threshold: 45, 30,
# 21, 14, 10, 7, 5, 3, 2, 1, 0 days out, then weekly until 60 days past expiry.
# Thresholds already notified are kept in the state file, so a missed day still
# fires on the next run and reruns don't repeat. Exits 0 unless CMD fails.
#
# App ids listed in ~/.config/apple-sign-expiry/ignores (one per line, with or without
# the team prefix, shell globs ok, # comments) are still shown but never flagged or
# notified.
set -euo pipefail

WARN_DAYS=${WARN_DAYS:-45}
THRESHOLDS="45 30 21 14 10 7 5 3 2 1 0"
EXPIRED_DAYS=60
STATE=${STATE:-$HOME/.config/apple-sign-expiry/state}
IGNORES=${IGNORES:-$HOME/.config/apple-sign-expiry/ignores}
DIRS=(
  "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"
  "$HOME/Library/MobileDevice/Provisioning Profiles"
)

notify=()
if [ "${1:-}" = "--notify" ] && [ $# -gt 1 ]; then
  shift
  notify=("$@")
elif [ $# -gt 0 ]; then
  echo "usage: ${0##*/} [--notify CMD [ARG...]]" >&2
  exit 2
fi

ignores=()
if [ -f "$IGNORES" ]; then
  while read -r pat; do
    pat=${pat%%#*}; pat=${pat%"${pat##*[![:space:]]}"}
    [ -z "$pat" ] || ignores+=("$pat")
  done <"$IGNORES"
fi

ignored() {
  local pat
  for pat in ${ignores[@]+"${ignores[@]}"}; do
    case "$1" in $pat) return 0;; esac
    case "${1#*.}" in $pat) return 0;; esac
  done
  return 1
}

now=$(date -u +%s)
status=0
message=""
newstate=""

rows=$(
  for dir in "${DIRS[@]}"; do
    [ -d "$dir" ] || continue
    for f in "$dir"/*.mobileprovision "$dir"/*.provisionprofile; do
      [ -e "$f" ] || continue
      plist=$(security cms -D -i "$f" 2>/dev/null) || continue
      exp=$(plutil -extract ExpirationDate raw -o - - <<<"$plist" 2>/dev/null) || continue
      name=$(plutil -extract Name raw -o - - <<<"$plist" 2>/dev/null) || name="?"
      appid=$(plutil -extract 'Entitlements.application-identifier' raw -o - - <<<"$plist" 2>/dev/null) \
        || appid=$(plutil -extract 'Entitlements.com\.apple\.application-identifier' raw -o - - <<<"$plist" 2>/dev/null) \
        || appid="?"
      echo "$exp|$appid|$name"
    done
  done | sort -r | awk -F'|' '!seen[$2]++' | sort
)

printf "%-12s %6s  %-45s %s\n" "EXPIRES" "DAYS" "APP ID" "PROFILE"
while IFS='|' read -r exp appid name; do
  [ -n "$exp" ] || continue
  exp_s=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$exp" +%s)
  days=$(( (exp_s - now) / 86400 ))
  flag=""
  if ignored "$appid"; then
    printf "%-12s %6s  %-45s %s%s\n" "${exp%%T*}" "$days" "$appid" "$name" "  (ignored)"
    continue
  elif [ "$days" -lt 0 ]; then flag="  << EXPIRED"; status=1
  elif [ "$days" -le "$WARN_DAYS" ]; then flag="  << SOON"; status=1
  fi
  printf "%-12s %6s  %-45s %s%s\n" "${exp%%T*}" "$days" "$appid" "$name" "$flag"

  # Current threshold: the nearest one at or above $days, or the week since expiry.
  bucket=""
  if [ "$days" -lt 0 ]; then
    [ $(( -days )) -gt "$EXPIRED_DAYS" ] || bucket="expired-w$(( -days / 7 ))"
  else
    for t in $THRESHOLDS; do
      [ "$days" -gt "$t" ] || bucket=$t
    done
  fi
  [ -n "$bucket" ] || continue

  line="$appid|$exp|$bucket"
  newstate+="$line"$'\n'
  if ! grep -Fxq "$line" "$STATE" 2>/dev/null; then
    if [ "$days" -lt 0 ]; then when="expired $(( -days ))d ago"
    else when="expires in ${days}d"
    fi
    message+="${appid#*.} $when (${exp%%T*})"$'\n'
  fi
done <<<"$rows"

[ ${#notify[@]} -gt 0 ] || exit $status

if [ -n "$message" ]; then
  "${notify[@]}" "${message%$'\n'}"
fi
mkdir -p "${STATE%/*}"
printf "%s" "$newstate" >"$STATE"
